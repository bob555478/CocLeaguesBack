# Lakebase Postgres (populated automatically by `neon link` / `neon env pull`)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Realtime
NEON_REALTIME_URL=https://ep-example.rt.c-13.us-east-1.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_1...

# Clash of Clans Official Developer API Token (https://developer.clashofclans.com)
COC_API_TOKEN=
